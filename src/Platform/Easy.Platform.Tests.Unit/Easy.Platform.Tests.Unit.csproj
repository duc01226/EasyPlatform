<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Easy.Platform\Easy.Platform.csproj" />
    <ProjectReference Include="..\Easy.Platform.AspNetCore\Easy.Platform.AspNetCore.csproj" />
    <ProjectReference Include="..\Easy.Platform.AzureFileStorage\Easy.Platform.AzureFileStorage.csproj" />
    <ProjectReference Include="..\Easy.Platform.Benchmark\Easy.Platform.Benchmark.csproj" />
    <ProjectReference Include="..\Easy.Platform.EfCore\Easy.Platform.EfCore.csproj" />
    <ProjectReference Include="..\Easy.Platform.FireBasePushNotification\Easy.Platform.FirebasePushNotification.csproj" />
    <ProjectReference Include="..\Easy.Platform.HangfireBackgroundJob\Easy.Platform.HangfireBackgroundJob.csproj" />
    <ProjectReference Include="..\Easy.Platform.MongoDB\Easy.Platform.MongoDB.csproj" />
    <ProjectReference Include="..\Easy.Platform.RabbitMQ\Easy.Platform.RabbitMQ.csproj" />
    <ProjectReference Include="..\Easy.Platform.RedisCache\Easy.Platform.RedisCache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.AutoMoq" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="[7.0.0]" />
    <!--
      Test-only EF Core provider. HasOwnedCollectionWithStoreGeneratedKey is pure MODEL inspection, but reading
      DbContext.Model still requires SOME provider to be configured. InMemory is the cheapest one that builds a real
      EF model (owned types, shadow keys and all) without a database, which keeps this a true unit test.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Roslyn.Analyzers" Version="1.0.3.4" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.6.0.109712">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
