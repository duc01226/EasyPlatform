{
  "AllowedHosts": "*",
  "AllowCorsOrigins": "http://localhost:4001",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "BravoSuiteModularMonolith",
    "MultiDbDemoDbDatabase": "BravoSuiteModularMonolith_TextSnippetMultiDbDemo"
  },
  "RabbitMqOptions": {
    "HostNames": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "LogProcessTime": true
  },
  "RedisCacheOptions": {
    "Connection": "localhost:6379,ConnectTimeout=60000,AsyncTimeout=60000,abortConnect=false"
  },
  "Caching": {
    "DefaultExpirationInSeconds": 300
  },
  "PersistenceConfiguration": {
    "BadQueryWarning": {
      "IsEnabled": false,
      "TotalItemsThreshold": 200,
      "SlowQueryMillisecondsThreshold": 500,
      "SlowWriteQueryMillisecondsThreshold": 3000,
      "IsLogWarningAsError": false
    }
  },
  "Platform": {
    "MessageBusStores": {
      "StrictCompositionValidation": true
    }
  },
  "TaskManagement": {
    "Messaging": {
      "Enabled": true,
      "InboxEnabled": true,
      "OutboxEnabled": true
    },
    "PersistenceMode": "Shared"
  }
}
