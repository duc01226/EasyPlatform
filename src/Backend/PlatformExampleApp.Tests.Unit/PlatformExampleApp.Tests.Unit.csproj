<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Unit tests for the PlatformExampleApp modules (TaskManagement bounded context and the ModularMonolith composite host).
    They live beside the example app, not in the framework's Easy.Platform.Tests.Unit, so framework tests never compile
    against application code. Package versions mirror Easy.Platform.Tests.Unit.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PlatformExampleApp.TaskManagement.Contracts\PlatformExampleApp.TaskManagement.Contracts.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TaskManagement.Domain\PlatformExampleApp.TaskManagement.Domain.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TaskManagement.Application\PlatformExampleApp.TaskManagement.Application.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TaskManagement.Api\PlatformExampleApp.TaskManagement.Api.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TaskManagement.Persistence.Mongo\PlatformExampleApp.TaskManagement.Persistence.Mongo.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.ModularMonolith.Api\PlatformExampleApp.ModularMonolith.Api.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TextSnippet.Api\PlatformExampleApp.TextSnippet.Api.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TextSnippet.Application\PlatformExampleApp.TextSnippet.Application.csproj" />
    <ProjectReference Include="..\PlatformExampleApp.TextSnippet.Persistence.Mongo\PlatformExampleApp.TextSnippet.Persistence.Mongo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="[7.0.0]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Roslyn.Analyzers" Version="1.0.3.4" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.6.0.109712">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
